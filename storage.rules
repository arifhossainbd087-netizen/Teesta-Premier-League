rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Player photos: Public read so auction screen, reports, and player profiles can display the photo
    // Writes restricted strictly to authorized administrators
    match /players/{seasonId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'arifhossainbd087@gmail.com' ||
        request.auth.token.email == 'Arifhossainbd087@gmail.com'
      ) && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|jpg)');
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
